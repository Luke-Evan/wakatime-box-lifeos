{
	"name": "obsidian-wakatime-box-lifeos",
	"version": "1.2.0",
	"description": "Obsidian plugin that writes your WakaTime project, language, editor and category stats into LifeOS daily notes.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"wakatime",
		"lifeos",
		"time-tracking",
		"daily-notes"
	],
	"author": "Luke-Evan",
	"contributors": [
		{
			"name": "complexzeng",
			"url": "https://github.com/simonla"
		}
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Luke-Evan/obsidian-wakatime-box-lifeos.git"
	},
	"homepage": "https://github.com/Luke-Evan/obsidian-wakatime-box-lifeos#readme",
	"bugs": {
		"url": "https://github.com/Luke-Evan/obsidian-wakatime-box-lifeos/issues"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
